[
	{
		"id": "view",
		"children": [
			{
				"caption": "Terminus",
				"id": "terminus_submenu",
				"children": [
					{
						"caption": "Toggle Persistence",
						"command": "toggle_terminus_persistence",
						"checkbox": true
					}
				]
			}
		]
	},
	{
		"id": "preferences",
		"children": [
			{
				"id": "package-settings",
				"children": [
					{
						"caption": "terminus-persistence",
						"children": [
							{
								"caption": "Settings",
								"command": "edit_settings",
								"args": {
									"base_file": "${packages}/terminus-persistence/terminus-persistence.sublime-settings",
									"default": "// terminus-persistence Settings - User\n// Place your settings in this file to override the defaults\n\n{\n\t$0\n}\n"
								}
							}
						]
					}
				]
			}
		]
	}
]
